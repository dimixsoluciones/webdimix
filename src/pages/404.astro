---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada | Dimix Soluciones">
  <Header />

  <main style="background-color: var(--color-dark-bg); color: var(--color-text-white);">
    <div class="page-404">

      <!-- Decoración de fondo -->
      <div class="bg-deco" aria-hidden="true">
        <div class="deco-circle c1"></div>
        <div class="deco-circle c2"></div>
        <div class="deco-grid"></div>
      </div>

      <!-- Contenido -->
      <div class="content-404">

        <!-- Número grande -->
        <div class="big-number" aria-hidden="true">
          <span class="digit">4</span>
          <div class="bolt-wrap">
            <i class="ti ti-bolt"></i>
          </div>
          <span class="digit">4</span>
        </div>

        <div class="text-block">
          <span class="error-badge">
            <i class="ti ti-alert-triangle"></i> Error 404
          </span>
          <h1 class="error-title">Parece que hay un<br/><span class="accent">cortocircuito.</span></h1>
          <p class="error-sub">
            La página que buscas no existe o ha sido movida.<br/>
            Pero nosotros sí estamos aquí para ayudarte.
          </p>
        </div>

        <!-- Acciones -->
        <div class="actions">
          <a href="/" class="btn-primary">
            <i class="ti ti-home"></i> Volver al inicio
          </a>
          <a href="/servicios" class="btn-secondary">
            <i class="ti ti-bolt"></i> Ver servicios
          </a>
          <a href="tel:+34624731030" class="btn-call">
            <i class="ti ti-phone"></i> Llamar ahora
          </a>
        </div>

        <!-- Links rápidos -->
        <div class="quick-links">
          <p class="quick-label">Páginas populares</p>
          <div class="quick-list">
            <a href="/servicios/mantenimiento/urgencias-24h" class="quick-link">
              <i class="ti ti-bolt"></i> Urgencias 24h
            </a>
            <a href="/servicios/renovables/placas-solares" class="quick-link">
              <i class="ti ti-sun"></i> Placas Solares
            </a>
            <a href="/servicios/renovables/cargadores-ve" class="quick-link">
              <i class="ti ti-car"></i> Cargadores VE
            </a>
            <a href="/proyectos" class="quick-link">
              <i class="ti ti-photo"></i> Proyectos
            </a>
            <a href="/empresa" class="quick-link">
              <i class="ti ti-users"></i> Empresa
            </a>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
.page-404 {
  position: relative;
  min-height: calc(100vh - 80px);
  margin-top: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rem clamp(1.5rem, 6vw, 6rem);
  overflow: hidden;
}

/* ── DECORACIÓN ── */
.bg-deco {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(229,114,0,0.07);
}
.c1 { width: 700px; height: 700px; right: -250px; top: -250px; }
.c2 { width: 400px; height: 400px; right: -50px; top: -50px; border-color: rgba(229,114,0,0.04); }

.deco-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(229,114,0,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(229,114,0,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
}

/* ── CONTENIDO ── */
.content-404 {
  position: relative;
  z-index: 1;
  text-align: center;
  max-width: 640px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2.5rem;
}

/* ── NÚMERO GRANDE ── */
.big-number {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  line-height: 1;
}

.digit {
  font-size: clamp(6rem, 18vw, 12rem);
  font-weight: 900;
  color: #1F2937;
  font-family: var(--font-display);
  letter-spacing: -4px;
  text-shadow: 0 0 80px rgba(229,114,0,0.08);
  animation: glitch 4s infinite;
}

.bolt-wrap {
  width: clamp(5rem, 14vw, 9rem);
  height: clamp(5rem, 14vw, 9rem);
  border-radius: 24px;
  background: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: clamp(3rem, 8vw, 5rem);
  box-shadow:
    0 0 0 12px rgba(229,114,0,0.08),
    0 0 0 24px rgba(229,114,0,0.04),
    0 20px 60px rgba(229,114,0,0.35);
  animation: pulse 2.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 12px rgba(229,114,0,0.08), 0 0 0 24px rgba(229,114,0,0.04), 0 20px 60px rgba(229,114,0,0.35); }
  50%       { box-shadow: 0 0 0 16px rgba(229,114,0,0.12), 0 0 0 32px rgba(229,114,0,0.06), 0 20px 80px rgba(229,114,0,0.5); }
}

@keyframes glitch {
  0%, 90%, 100% { transform: none; opacity: 1; }
  92%           { transform: translateX(-3px); opacity: 0.8; }
  94%           { transform: translateX(3px); opacity: 0.9; }
  96%           { transform: translateX(-2px); opacity: 0.85; }
  98%           { transform: translateX(0); opacity: 1; }
}

/* ── TEXTO ── */
.text-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.error-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 14px;
  border-radius: 4px;
  border: 1px solid rgba(229,114,0,0.3);
  background: rgba(229,114,0,0.08);
  color: var(--color-accent);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 3px;
}

.error-title {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 800;
  color: white;
  margin: 0;
  line-height: 1.15;
}

.accent {
  color: var(--color-accent);
}

.error-sub {
  font-size: 1rem;
  color: #6B7280;
  line-height: 1.7;
  margin: 0;
}

/* ── BOTONES ── */
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  background: var(--color-accent);
  color: white;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s;
}
.btn-primary:hover {
  background: var(--color-accent-hover);
  transform: translateY(-2px);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border: 1px solid #374151;
  background: #1F2937;
  color: #D1D5DB;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.2s;
}
.btn-secondary:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
  transform: translateY(-2px);
}

.btn-call {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border: 1px solid #1F2937;
  background: transparent;
  color: #6B7280;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: all 0.2s;
}
.btn-call:hover {
  color: white;
  border-color: #374151;
  transform: translateY(-2px);
}

/* ── LINKS RÁPIDOS ── */
.quick-links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding-top: 1.5rem;
  border-top: 1px solid #1F2937;
  width: 100%;
}

.quick-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #4B5563;
  margin: 0;
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.quick-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 14px;
  border-radius: 100px;
  border: 1px solid #1F2937;
  background: transparent;
  color: #6B7280;
  font-size: 0.8rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
}
.quick-link:hover {
  border-color: rgba(229,114,0,0.3);
  color: var(--color-accent);
  background: rgba(229,114,0,0.05);
}
</style>