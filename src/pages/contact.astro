---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="Contacto | Dimix Soluciones Madrid">
  <Header />

  <main style="background-color: var(--color-dark-bg); color: var(--color-text-white);">

    <!-- HERO -->
    <div class="contact-hero">
      <div class="contact-hero-inner">
        <span class="contact-badge"><i class="ti ti-message"></i> Contacto</span>
        <h1 class="contact-title">Hablemos de<br/><span style="color: var(--color-accent);">tu proyecto.</span></h1>
        <p class="contact-sub">
          Cuéntanos qué necesitas. Te respondemos en menos de 2 horas en horario laboral,
          o llámanos directamente si es urgente.
        </p>

        <!-- Datos rápidos -->
        <div class="contact-quick">
          <a href="tel:+34600000000" class="contact-quick-item">
            <div class="contact-quick-icon"><i class="ti ti-phone"></i></div>
            <div>
              <span class="contact-quick-label">Teléfono / WhatsApp</span>
              <span class="contact-quick-val">600 000 000</span>
            </div>
          </a>
          <a href="mailto:info@dimixsoluciones.com" class="contact-quick-item">
            <div class="contact-quick-icon"><i class="ti ti-mail"></i></div>
            <div>
              <span class="contact-quick-label">Email</span>
              <span class="contact-quick-val">info@dimixsoluciones.com</span>
            </div>
          </a>
          <div class="contact-quick-item">
            <div class="contact-quick-icon"><i class="ti ti-map-pin"></i></div>
            <div>
              <span class="contact-quick-label">Zona de servicio</span>
              <span class="contact-quick-val">Comunidad de Madrid</span>
            </div>
          </div>
          <div class="contact-quick-item">
            <div class="contact-quick-icon"><i class="ti ti-clock"></i></div>
            <div>
              <span class="contact-quick-label">Urgencias</span>
              <span class="contact-quick-val">24h / 365 días</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Decoración -->
      <div class="contact-deco" aria-hidden="true">
        <div class="deco-c1"></div>
        <div class="deco-c2"></div>
        <div class="deco-grid"></div>
      </div>
    </div>

    <!-- FORMULARIO -->
    <Contact />

  </main>

  <Footer />
</Layout>

<style>
.contact-hero {
  position: relative;
  margin-top: 80px;
  padding: 6rem clamp(1.5rem, 6vw, 6rem) 5rem;
  border-bottom: 1px solid #1F2937;
  overflow: hidden;
}

.contact-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 800px;
}

.contact-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 14px;
  border-radius: 4px;
  border: 1px solid rgba(229,114,0,0.35);
  background: rgba(229,114,0,0.08);
  color: var(--color-accent);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 3px;
  margin-bottom: 1.25rem;
}

.contact-title {
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  font-weight: 900;
  color: white;
  line-height: 1.05;
  margin: 0 0 1.5rem 0;
}

.contact-sub {
  font-size: 1.1rem;
  color: #9CA3AF;
  line-height: 1.8;
  margin: 0 0 3rem 0;
  max-width: 580px;
}

/* Datos rápidos */
.contact-quick {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  max-width: 680px;
}

.contact-quick-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.1rem 1.25rem;
  background: #1F2937;
  border: 1px solid #374151;
  border-radius: 12px;
  text-decoration: none;
  transition: all 0.2s;
}
a.contact-quick-item:hover {
  border-color: rgba(229,114,0,0.4);
  background: rgba(229,114,0,0.05);
}

.contact-quick-icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  border-radius: 10px;
  background: rgba(229,114,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-accent);
  font-size: 1.1rem;
}

.contact-quick-label {
  display: block;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #6B7280;
  margin-bottom: 2px;
}

.contact-quick-val {
  display: block;
  font-size: 0.9rem;
  font-weight: 700;
  color: white;
}

/* Decoración */
.contact-deco {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}
.deco-c1 {
  position: absolute;
  width: 600px; height: 600px;
  right: -200px; top: -200px;
  border-radius: 50%;
  border: 1px solid rgba(229,114,0,0.07);
}
.deco-c2 {
  position: absolute;
  width: 350px; height: 350px;
  right: -30px; top: -30px;
  border-radius: 50%;
  border: 1px solid rgba(229,114,0,0.04);
}
.deco-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(229,114,0,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(229,114,0,0.025) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 100% at 80% 50%, black 0%, transparent 70%);
}

/* Responsive */
@media (max-width: 580px) {
  .contact-quick {
    grid-template-columns: 1fr;
  }
}
</style>