---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { services } from '../../data/services';
import { Icon } from 'astro-icon/components';

const categorias = [
  {
    id: 'instalaciones',
    label: 'Instalaciones',
    icon: 'tabler:home',
    desc: 'Proyectos eléctricos completos para viviendas y locales',
    slugPrefix: 'instalaciones',
  },
  {
    id: 'mantenimiento',
    label: 'Mantenimiento',
    icon: 'tabler:tool',
    desc: 'Urgencias, reparaciones y actualización de cuadros',
    slugPrefix: 'mantenimiento',
  },
  {
    id: 'renovables',
    label: 'Renovables',
    icon: 'tabler:sun',
    desc: 'Energía solar y movilidad eléctrica sostenible',
    slugPrefix: 'renovables',
  },
];

const servicesByCategory = categorias.map(cat => ({
  ...cat,
  items: services.filter(s => s.slug.startsWith(cat.slugPrefix)),
}));
---

<Layout 
  title="Servicios de Electricidad en Madrid | Instalaciones y Mantenimiento — Dimix"
  description="Instalaciones eléctricas, reformas, cuadros eléctricos, CCTV, climatización y energía solar fotovoltaica en Madrid. Técnicos certificados y presupuesto gratis."
>  
<Header />

  <main class="w-full overflow-x-hidden" style="background-color: var(--color-dark-bg); color: var(--color-text-white);">
    <div class="servicios-page">

      <aside class="left-panel">

        <div class="left-top">
          <span class="left-badge"><Icon name="tabler:bolt" /> Servicios</span>
          <h1 class="left-title">¿Qué necesitas?</h1>
          <p class="left-sub">Selecciona una categoría para ver todos los servicios disponibles.</p>
        </div>

        <nav class="cat-nav">
          {categorias.map((cat, i) => (
            <button
              class={`cat-btn ${i === 0 ? 'active' : ''}`}
              data-cat={cat.id}
              type="button"
            >
              <div class="cat-btn-icon">
                <Icon name={cat.icon} />
              </div>
              <div class="cat-btn-info">
                <span class="cat-btn-label">{cat.label}</span>
                <span class="cat-btn-desc">{cat.desc}</span>
              </div>
              <Icon name="tabler:chevron-right" class="cat-btn-arrow" />
            </button>
          ))}
        </nav>

        <div class="left-bottom">
          <p class="left-bottom-text">¿Dudas? Llámanos</p>
          <a href="tel:+34624731030" class="left-call-btn">
            <Icon name="tabler:phone" /> 624 731 030
          </a>
        </div>

      </aside>

      <div class="right-panel">
        {servicesByCategory.map((cat, i) => (
          <div
            class={`cat-panel ${i === 0 ? 'active' : ''}`}
            data-panel={cat.id}
          >
            <div class="panel-header">
              <div>
                <p class="panel-label">{cat.label}</p>
                <h2 class="panel-title">{cat.desc}</h2>
              </div>
              <span class="panel-count">{cat.items.length} servicio{cat.items.length !== 1 ? 's' : ''}</span>
            </div>

            <div class="panel-grid">
              {cat.items.length > 0 ? (
                cat.items.map((service, j) => (
                  <a 
                    href={"/servicios/" + service.slug}
                    class="svc-card"
                    style={"--i: " + j}
                  >
                    <div class="svc-img-wrap">
                      <img src={service.image} alt={service.title} class="svc-img" />
                      <div class="svc-img-overlay"></div>
                      <div class="svc-icon">
                         <Icon name={service.icon} />
                      </div>
                    </div>
                    <div class="svc-body">
                      <p class="svc-subtitle">{service.subtitle}</p>
                      <h3 class="svc-title">{service.title}</h3>
                      <p class="svc-desc">{service.description.slice(0, 90)}...</p>
                      <div class="svc-features">
                        {service.features.slice(0, 2).map(f => (
                          <span class="svc-feature">
                            <Icon name="tabler:check" /> {f}
                          </span>
                        ))}
                      </div>
                      <div class="svc-cta">
                        Ver más <Icon name="tabler:arrow-right" />
                      </div>
                    </div>
                  </a>
                ))
              ) : (
                <div class="col-span-full py-10 text-center text-gray-500">
                  <p>Próximamente añadiremos servicios en esta categoría.</p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  function initCategoryFilters() {
    const buttons = document.querySelectorAll('.cat-btn');
    const panels = document.querySelectorAll('.cat-panel');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat');

        // Remover clase active de todos los botones y paneles
        buttons.forEach(b => b.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        // Añadir clase active al botón clickeado
        btn.classList.add('active');
        
        // Añadir clase active al panel correspondiente
        const targetPanel = document.querySelector(`[data-panel="${cat}"]`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCategoryFilters);
  } else {
    initCategoryFilters();
  }

  // También inicializar con Astro page transitions si están activas
  document.addEventListener('astro:page-load', initCategoryFilters);
</script>

<style>
/* ── LAYOUT GENERAL ── */
* {
  box-sizing: border-box;
}

.servicios-page {
  display: grid;
  grid-template-columns: 320px 1fr;
  min-height: calc(100vh - 80px);
  margin-top: 80px;
  overflow: hidden;
  max-width: 100vw;
  width: 100%;
}

/* ── PANEL IZQUIERDO ── */
.left-panel {
  display: flex;
  flex-direction: column;
  background: #0F1724;
  border-right: 1px solid #1F2937;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 2.5rem 1.75rem;
  max-width: 100%;
}

.left-top {
  margin-bottom: 2rem;
}

.left-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 12px;
  border-radius: 4px;
  border: 1px solid rgba(229,114,0,0.3);
  background: rgba(229,114,0,0.07);
  color: var(--color-accent);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 3px;
  margin-bottom: 1rem;
}

.left-title {
  font-size: 1.75rem;
  font-weight: 800;
  color: white;
  margin: 0 0 0.5rem 0;
  line-height: 1.1;
}

.left-sub {
  font-size: 0.825rem;
  color: #6B7280;
  margin: 0;
  line-height: 1.5;
}

/* Navegación categorías */
.cat-nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.cat-btn {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border-radius: 12px;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition: all 0.2s ease;
  width: 100%;
  max-width: 100%;
}

.cat-btn:hover {
  background: rgba(255,255,255,0.04);
  border-color: #374151;
}

.cat-btn.active {
  background: rgba(229,114,0,0.1);
  border-color: rgba(229,114,0,0.3);
}

.cat-btn-icon {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 10px;
  background: #1F2937;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B7280;
  font-size: 1.25rem;
  transition: all 0.2s;
}

.cat-btn.active .cat-btn-icon {
  background: rgba(229,114,0,0.15);
  color: var(--color-accent);
}

.cat-btn-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.cat-btn-label {
  display: block;
  font-size: 0.9rem;
  font-weight: 700;
  color: #9CA3AF;
  margin-bottom: 2px;
  transition: color 0.2s;
}

.cat-btn.active .cat-btn-label {
  color: white;
}

.cat-btn-desc {
  display: block;
  font-size: 0.75rem;
  color: #4B5563;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.cat-btn-arrow {
  font-size: 0.75rem;
  color: #374151;
  transition: all 0.2s;
  flex-shrink: 0;
}

.cat-btn.active .cat-btn-arrow {
  color: var(--color-accent);
  transform: translateX(3px);
}

/* Bottom del panel */
.left-bottom {
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #1F2937;
}

.left-bottom-text {
  font-size: 0.75rem;
  color: #4B5563;
  margin: 0 0 10px 0;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
}

.left-call-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 10px;
  background: var(--color-accent);
  color: white;
  font-weight: 700;
  font-size: 0.875rem;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s;
}
.left-call-btn:hover {
  background: var(--color-accent-hover);
}

/* ── PANEL DERECHO ── */
.right-panel {
  overflow-y: auto;
  overflow-x: hidden;
  background: var(--color-dark-bg);
  position: relative;
  max-width: 100%;
}

.cat-panel {
  display: none;
  padding: 2.5rem;
  height: 100%;
  box-sizing: border-box;
  animation: fadeIn 0.25s ease;
  max-width: 100%;
}

.cat-panel.active {
  display: block;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateX(20px); }
  to   { opacity: 1; transform: translateX(0); }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #1F2937;
  flex-wrap: wrap;
  gap: 1rem;
}

.panel-label {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 3px;
  color: var(--color-accent);
  margin: 0 0 4px 0;
}

.panel-title {
  font-size: 1.35rem;
  font-weight: 700;
  color: white;
  margin: 0;
  max-width: 100%;
  word-wrap: break-word;
}

.panel-count {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #4B5563;
  padding: 5px 12px;
  border: 1px solid #1F2937;
  border-radius: 100px;
  white-space: nowrap;
}

/* ── GRID DE CARDS ── */
.panel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
  max-width: 100%;
}

/* ── CARD SERVICIO ── */
.svc-card {
  display: flex;
  flex-direction: column;
  background: #1F2937;
  border-radius: 14px;
  border: 1px solid #374151;
  overflow: hidden;
  text-decoration: none;
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  animation: cardIn 0.35s ease both;
  animation-delay: calc(var(--i, 0) * 60ms);
  max-width: 100%;
}

.svc-card:hover {
  transform: translateY(-4px);
  border-color: rgba(229,114,0,0.35);
  box-shadow: 0 12px 32px rgba(0,0,0,0.35);
}

@keyframes cardIn {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

.svc-img-wrap {
  position: relative;
  height: 160px;
  overflow: hidden;
  width: 100%;
}

.svc-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.svc-card:hover .svc-img {
  transform: scale(1.05);
}

.svc-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(17,24,39,0.85) 0%, transparent 70%);
}

.svc-icon {
  position: absolute;
  bottom: 0.75rem;
  right: 0.75rem;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1rem;
  box-shadow: 0 4px 10px rgba(229,114,0,0.4);
}

.svc-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  flex: 1;
  max-width: 100%;
}

.svc-subtitle {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--color-accent);
  margin: 0 0 4px 0;
}

.svc-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: white;
  margin: 0 0 8px 0;
  word-wrap: break-word;
}

.svc-desc {
  font-size: 0.8rem;
  color: #9CA3AF;
  line-height: 1.5;
  margin: 0 0 1rem 0;
  flex: 1;
  word-wrap: break-word;
}

.svc-features {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 1rem;
}

.svc-feature {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.75rem;
  color: #6B7280;
  word-wrap: break-word;
}

.svc-feature i, .svc-feature svg {
  color: var(--color-accent);
  font-size: 10px;
  flex-shrink: 0;
}

.svc-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--color-accent);
  padding-top: 0.75rem;
  border-top: 1px solid #374151;
}

/* ── RESPONSIVE MÓVIL ── */
@media (max-width: 768px) {
  .servicios-page {
    grid-template-columns: 1fr;
    height: auto;
    overflow-x: hidden;
    overflow-y: visible;
    margin-top: 80px;
  }
  
  .left-panel {
    height: auto;
    overflow: visible;
    padding: 1.5rem;
    border-right: none;
    border-bottom: 1px solid #1F2937;
    max-width: 100vw;
    width: 100%;
  }
  
  .right-panel {
    overflow: visible;
    height: auto;
    max-width: 100vw;
    width: 100%;
  }
  
  .cat-panel {
    height: auto;
    padding: 1.5rem;
    max-width: 100%;
  }
  
  .panel-grid {
    grid-template-columns: 1fr;
    max-width: 100%;
  }
  
  .panel-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .cat-btn-desc {
    white-space: normal;
  }
}