---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import { services } from '../../data/services';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const otherServices = services.filter(s => s.slug !== service.slug);
---

<Layout title={`${service.title} | Servicios Dimix Madrid`}>
  <Header />

  <main style="background-color: var(--color-dark-bg); color: var(--color-text-white);">

    <!-- HERO -->
    <div style="position: relative; width: 100%; height: 360px; margin-top: 80px; overflow: hidden;">
      <img
        src={service.image}
        alt={service.title}
        style="width: 100%; height: 100%; object-fit: cover; object-position: center;"
      />
      <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.92), rgba(0,0,0,0.6), transparent);"></div>
      <div style="position: absolute; inset: 0; display: flex; align-items: center; padding: 0 clamp(1.5rem, 5vw, 5rem);">
        <div class="animate-slideRight" style="max-width: 600px;">
          <span style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; margin-bottom: 12px; border-radius: 4px; border: 1px solid rgba(229,114,0,0.4); background: rgba(0,0,0,0.5); color: var(--color-accent); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 3px;">
            <i class={`ti ${service.icon}`}></i> {service.subtitle}
          </span>
          <h1 style="font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 700; color: white; text-transform: uppercase; line-height: 1.1; margin: 0;">
            {service.title}
          </h1>
        </div>
      </div>
    </div>

    <!-- CONTENIDO: wrapper externo -->
    <div class="page-wrapper">

      <!-- GRID DE DOS COLUMNAS -->
      <div class="two-col-layout">

        <!-- COLUMNA PRINCIPAL -->
        <div class="main-col">

          <!-- Descripción -->
          <section class="content-section">
            <h2 class="section-title">Descripción del Servicio</h2>
            <p style="color: #D1D5DB; font-size: 1.05rem; line-height: 1.8; margin: 0;">
              {service.description}
            </p>
            <div class="features-grid">
              {service.features.map(feature => (
                <div class="feature-card">
                  <div class="check-icon">
                    <i class="ti ti-check"></i>
                  </div>
                  <span style="font-size: 0.875rem; font-weight: 700; color: white;">{feature}</span>
                </div>
              ))}
            </div>
          </section>

          <!-- Cuándo necesitas -->
          <section class="content-section">
            <h3 class="section-subtitle">¿Cuándo necesitas este servicio?</h3>
            <div class="problems-grid">
              {service.commonProblems.map(problem => (
                <div class="problem-card">
                  <i class="ti ti-alert-circle" style="color: #6B7280; font-size: 1.5rem; display: block; margin-bottom: 12px;"></i>
                  <h4 style="font-weight: 700; color: white; margin: 0 0 8px 0;">{problem.title}</h4>
                  <p style="font-size: 0.875rem; color: #9CA3AF; margin: 0;">{problem.desc}</p>
                </div>
              ))}
            </div>
          </section>

          <!-- Proceso -->
          <section class="content-section">
            <h3 class="section-subtitle">Nuestro Proceso de Trabajo</h3>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              {service.process.map((step) => (
                <div style="display: flex; align-items: flex-start; gap: 1.25rem;">
                  <div class="step-number">{step.step}</div>
                  <div class="step-card">
                    <h4 style="font-weight: 700; color: white; margin: 0 0 4px 0;">{step.title}</h4>
                    <p style="font-size: 0.875rem; color: #9CA3AF; margin: 0;">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

        </div>

        <!-- SIDEBAR -->
        <aside class="sidebar-col">
          <div class="sidebar-sticky">

            <!-- CTA -->
            <div class="cta-card">
              <div class="cta-icon">
                <i class={`ti ${service.icon}`}></i>
              </div>
              <h3 style="font-size: 1.5rem; font-weight: 700; color: white; margin: 0 0 8px 0;">¿Te interesa?</h3>
              <p style="color: #9CA3AF; font-size: 0.875rem; margin: 0 0 1.5rem 0;">
                Hablamos directamente por teléfono o WhatsApp para darte una solución rápida.
              </p>
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <a href="tel:+34600000000" class="btn-call">
                  <i class="ti ti-phone"></i> Llamar Ahora
                </a>
                <a href="https://wa.me/34600000000" class="btn-whatsapp">
                  <i class="ti ti-brand-whatsapp"></i> WhatsApp
                </a>
              </div>
            </div>

            <!-- Más servicios -->
            <div class="more-services">
              <div class="more-services-header">Más Servicios</div>
              {otherServices.map(s => (
                <a href={"/servicios/" + s.slug} class="service-link">
                  <span style="font-size: 0.875rem;">{s.title}</span>
                  <i class="ti ti-chevron-right" style="font-size: 0.75rem; color: var(--color-accent); flex-shrink: 0;"></i>
                </a>
              ))}
            </div>

          </div>
        </aside>

      </div>
    </div>

    <Contact />
  </main>

  <Footer />
</Layout>

<style>
  /* ── LAYOUT ── */
  .page-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 5rem clamp(1.5rem, 5vw, 5rem) 4rem;
  }

  .two-col-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .two-col-layout {
      grid-template-columns: 1fr 360px;
      gap: 4rem;
    }
  }

  /* ── SIDEBAR STICKY ── */
  .sidebar-col {
    width: 100%;
  }

  .sidebar-sticky {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .sidebar-sticky {
      position: sticky;
      top: 7rem;
    }
  }

  /* ── SECCIONES ── */
  .content-section {
    padding-bottom: 4rem;
    margin-bottom: 0;
    border-bottom: 1px solid #1F2937;
  }
  .content-section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin: 0 0 1.5rem 0;
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
  }

  .section-subtitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin: 0 0 1.5rem 0;
  }

  /* ── FEATURES ── */
  .features-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .feature-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-dark-card);
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid #374151;
  }

  .check-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(229,114,0,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 12px;
  }

  /* ── PROBLEMS ── */
  .problems-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .problem-card {
    background: var(--color-dark-card);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid #374151;
    transition: border-color 0.2s;
  }
  .problem-card:hover {
    border-color: rgba(229,114,0,0.5);
  }

  /* ── PROCESS ── */
  .step-number {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid rgba(229,114,0,0.4);
    background: var(--color-dark-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.875rem;
  }

  .step-card {
    background: var(--color-dark-card);
    flex: 1;
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid #374151;
  }

  /* ── CTA CARD ── */
  .cta-card {
    background: linear-gradient(135deg, #1F2937, #111827);
    padding: 2rem;
    border-radius: 16px;
    border: 1px solid #374151;
    text-align: center;
  }

  .cta-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    background: var(--color-accent);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.75rem;
    box-shadow: 0 8px 24px rgba(229,114,0,0.3);
  }

  .btn-call {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: white;
    color: #111827;
    font-weight: 700;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
    box-sizing: border-box;
  }
  .btn-call:hover { background: #E5E7EB; }

  .btn-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: #25D366;
    color: white;
    font-weight: 700;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s;
    box-sizing: border-box;
  }
  .btn-whatsapp:hover { background: #20bd5a; }

  /* ── MÁS SERVICIOS ── */
  .more-services {
    background: var(--color-dark-card);
    border-radius: 16px;
    border: 1px solid #374151;
    overflow: hidden;
  }

  .more-services-header {
    padding: 1rem;
    background: rgba(55,65,81,0.5);
    border-bottom: 1px solid #374151;
    font-weight: 700;
    color: white;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    color: #9CA3AF;
    text-decoration: none;
    border-bottom: 1px solid #374151;
    transition: all 0.2s;
  }
  .service-link:last-child { border-bottom: none; }
  .service-link:hover {
    color: white;
    background: rgba(255,255,255,0.05);
  }

  /* ── ANIMATION ── */
  .animate-slideRight {
    animation: slideRight 0.8s ease-out forwards;
  }
  @keyframes slideRight {
    from { opacity: 0; transform: translateX(-20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .features-grid,
    .problems-grid {
      grid-template-columns: 1fr;
    }
  }
</style>