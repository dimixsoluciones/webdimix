---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Proyectos Dimix`}>
  <Header />
  
  <main class="bg-dark-bg text-white">
    
    <div class="relative w-full h-[250px] md:h-[40vh] mt-20 overflow-hidden group">
       <img 
         src={project.image} 
         alt={`Foto de ${project.title}`} 
         class="w-full h-full object-cover transition-transform duration-[3s] group-hover:scale-105"
         style="object-position: center 40%;" 
       />
       
       <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/70 to-transparent sm:via-black/50"></div>
       
       <div class="absolute inset-0 container mx-auto px-8 lg:px-20 flex flex-col justify-center items-start">
          <div class="animate-slideRight max-w-2xl relative z-10">
            <span class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded border border-accent/30 bg-black/50 text-accent text-xs font-bold uppercase tracking-widest backdrop-blur-md">
                <i class="ti ti-tag"></i> {project.category}
            </span>
            
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-white uppercase leading-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)]">
                {project.title}
            </h1>
          </div>
       </div>
    </div>

    <div class="bg-dark-card border-y border-gray-800 relative z-10 shadow-lg">
        <div class="container mx-auto max-w-7xl px-8 lg:px-20 py-4">
            <div class="flex flex-wrap justify-between items-center gap-4 text-sm">
                
                <div class="flex flex-wrap gap-6 md:gap-12 text-gray-300">
                    <div class="flex items-center gap-3">
                        <i class="ti ti-map-pin text-accent text-lg"></i>
                        <span class="font-medium">{project.location}</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <i class="ti ti-calendar text-accent text-lg"></i>
                        <span class="font-medium">2024</span>
                    </div>

                    <div class="flex items-center gap-3">
                        <i class="ti ti-building-skyscraper text-accent text-lg"></i>
                        <span class="font-medium">Cliente Privado</span>
                    </div>
                </div>
                
                <a href="/proyectos" class="hidden md:flex items-center gap-2 text-gray-500 hover:text-white transition-colors text-xs uppercase font-bold tracking-widest group">
                    <i class="ti ti-grid-dots group-hover:text-accent transition-colors"></i> Ver todos
                </a>
            </div>
        </div>
    </div>

    <section class="container mx-auto max-w-7xl px-8 lg:px-20 py-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <div class="lg:col-span-8 space-y-10">
            
            <div>
                <h2 class="text-2xl font-display font-bold text-white mb-4">Resumen Ejecutivo</h2>
                <p class="text-gray-300 text-lg leading-relaxed text-justify">
                    {project.description} Este proyecto representa nuestro compromiso con la eficiencia y la seguridad, adaptándonos a las necesidades específicas del espacio y del cliente para entregar un resultado duradero.
                </p>
            </div>

            <div class="grid grid-cols-1 gap-6">
                <div class="flex gap-4 p-6 rounded-xl border border-gray-800 bg-gray-900/50">
                    <div class="shrink-0 mt-1">
                        <div class="w-10 h-10 rounded-full bg-red-500/10 flex items-center justify-center text-red-500">
                            <i class="ti ti-alert-triangle text-xl"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white mb-2">El Desafío Inicial</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">{project.challenge}</p>
                    </div>
                </div>

                <div class="flex gap-4 p-6 rounded-xl border border-gray-800 bg-gray-900/50">
                    <div class="shrink-0 mt-1">
                        <div class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center text-green-500">
                            <i class="ti ti-bulb text-xl"></i>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white mb-2">Solución Técnica Dimix</h3>
                        <p class="text-gray-400 text-sm leading-relaxed">{project.solution}</p>
                    </div>
                </div>
            </div>

            <div>
                <h3 class="text-xl font-bold text-white mb-6 border-l-4 border-accent pl-4">Galería de Ejecución</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    <div class="aspect-video rounded-lg overflow-hidden border border-gray-800 cursor-pointer group">
                        <img src={project.image} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Detalle" />
                    </div>
                    <div class="aspect-video rounded-lg overflow-hidden border border-gray-800 cursor-pointer group">
                        <img src={project.image} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 grayscale hover:grayscale-0" alt="Detalle" />
                    </div>
                    <div class="aspect-video rounded-lg overflow-hidden border border-gray-800 cursor-pointer group">
                        <img src={project.image} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="Detalle" />
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-4">
            <div class="sticky top-32 space-y-6">
                
                <div class="bg-dark-card rounded-2xl border border-gray-700 overflow-hidden shadow-2xl">
                    <div class="bg-gray-800/50 p-4 border-b border-gray-700 flex justify-between items-center">
                        <h3 class="font-bold text-white flex items-center gap-2">
                            <i class="ti ti-clipboard-list text-accent"></i> Ficha Técnica
                        </h3>
                        <span class="text-[10px] bg-accent/20 text-accent px-2 py-0.5 rounded uppercase font-bold">Verificado</span>
                    </div>
                    
                    <div class="divide-y divide-gray-800">
                        {project.specs.map((spec) => (
                            <div class="flex items-start gap-3 p-4 hover:bg-white/5 transition-colors">
                                <i class="ti ti-check text-accent mt-0.5 shrink-0"></i>
                                <span class="text-sm text-gray-300 font-medium">{spec}</span>
                            </div>
                        ))}
                    </div>
                </div>

                <div class="bg-gradient-to-br from-gray-800 to-dark-bg p-6 rounded-2xl border border-gray-700 text-center relative overflow-hidden group">
                    <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-accent/20 rounded-full blur-2xl group-hover:bg-accent/30 transition-colors"></div>
                    
                    <h4 class="text-white font-bold text-lg mb-2 relative z-10">¿Buscas resultados así?</h4>
                    <p class="text-gray-400 text-xs mb-6 relative z-10">Realizamos estudios de viabilidad y presupuesto en 24h.</p>
                    
                    <a href="#contacto" class="relative z-10 w-full inline-flex justify-center items-center gap-2 bg-accent hover:bg-accent-hover text-white font-bold py-3 rounded-lg transition-all shadow-lg shadow-accent/20 transform group-hover:-translate-y-1">
                        Solicitar Presupuesto <i class="ti ti-arrow-right"></i>
                    </a>
                </div>

            </div>
        </div>

      </div>
    </section>

    <Contact />

  </main>
  
  <Footer />
</Layout>

<style>
    .animate-slideRight { animation: slideRight 0.8s ease-out forwards; }
    @keyframes slideRight { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }
</style>