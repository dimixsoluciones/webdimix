---
const services = [
  {
    title: "Instalaciones Eléctricas",
    desc: "Cableado completo para obra nueva y reformas.",
    img: "https://images.unsplash.com/photo-1544724569-5f546fd6dd2d?q=80&w=2000&auto=format&fit=crop",
    href: "/servicios/instalaciones/electricas"
  },
  {
    title: "Instalaciones Fotovoltaicas",
    desc: "Instalación fotovoltaica para autoconsumo.",
    img: "https://images.unsplash.com/photo-1509391366360-2e959784a276?q=80&w=2000&auto=format&fit=crop",
    href: "/servicios/instalaciones/fotovoltaicas"
  },
  {
    title: "Cuadros Eléctricos",
    desc: "Actualización a normativa y aumento de potencia.",
    img: "https://images.unsplash.com/photo-1558402529-d2638a7023e9?q=80&w=2000&auto=format&fit=crop",
    href: "/servicios/instalaciones/cuadros-electricos"
  },
  {
    title: "Reformas Eléctricas",
    desc: "Adecuación y modernización de instalaciones en reformas.",
    img: "https://images.unsplash.com/photo-1621905252507-b35492cc74b4?q=80&w=2000&auto=format&fit=crop",
    href: "/servicios/instalaciones/reformas-electricas"
  },
  {
    title: "Instalaciones de Climatización",
    desc: "Equipos de frío y calor de alta eficiencia energética.",
    img: "https://images.unsplash.com/photo-1585771724684-38269d6639fd?q=80&w=2000&auto=format&fit=crop",
    href: "/servicios/instalaciones/climatizacion"
  },
  {
    title: "CCTV y Antenas",
    desc: "Videovigilancia y señal de TV para tu hogar o negocio.",
    img: "https://images.unsplash.com/photo-1557597774-9d273605dfa9?q=80&w=2000&auto=format&fit=crop",
    href: "/servicios/instalaciones/cctv-antenas"
  }
];
---

<section id="servicios" class="py-24 bg-white text-dark-bg">
  <div class="container mx-auto max-w-7xl px-8 lg:px-20">
    
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-0.5 bg-accent"></span>
          <span class="text-accent font-bold tracking-[0.2em] uppercase text-sm">Nuestros Servicios</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-display font-bold text-dark-bg uppercase leading-tight">
          Soluciones Técnicas <br/>Integrales
        </h2>
      </div>
      <p class="max-w-md text-gray-600 text-lg leading-relaxed text-right md:text-left hidden md:block border-l-2 border-gray-200 pl-6">
        Cubrimos todas las necesidades eléctricas con garantía certificada y cumplimiento del REBT.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <a href={service.href} class="group relative h-[400px] w-full rounded-2xl overflow-hidden shadow-lg cursor-pointer block">
          
          <div class="absolute inset-0 bg-gray-900">
            <img 
              src={service.img} 
              alt={service.title} 
              class="w-full h-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-110 group-hover:opacity-100"
            />
          </div>
          
          <div class="absolute bottom-0 left-0 w-[90%] bg-dark-bg p-6 rounded-tr-[2rem] border-t border-r border-gray-700/50 transition-all duration-300 group-hover:bg-accent group-hover:border-accent">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="text-white font-display font-bold text-xl mb-1 group-hover:text-white">
                  {service.title}
                </h3>
                <p class="text-gray-400 text-xs leading-relaxed group-hover:text-white/90">
                  {service.desc}
                </p>
              </div>
              <div class="bg-gray-700/50 p-2 rounded-full text-white group-hover:bg-white group-hover:text-accent transition-colors">
                 <i class="ti ti-arrow-up-right"></i>
              </div>
            </div>
          </div>

        </a>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a href="/servicios" class="inline-flex items-center gap-2 font-bold text-dark-bg border-b-2 border-accent pb-1 hover:text-accent transition-colors">
        Ver todos los servicios
        <i class="ti ti-arrow-right"></i>
      </a>
    </div>

  </div>
</section>