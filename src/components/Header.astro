---
const navItems = [
  { name: 'Servicios', href: '/#servicios' }, // Enlace ancla a la sección de la Home
  { name: 'Empresa', href: '/empresa' },
  { name: 'Constructoras', href: '/empresa/constructoras' },
  { name: 'Contacto', href: '/contacto' },
];
---

<header class="sticky top-0 z-50 bg-white shadow-md w-full">
  <div class="container mx-auto px-4 py-4 flex justify-between items-center">
    
    <a href="/" class="text-2xl font-display font-bold text-primary-dark tracking-tight">
      Dimix <span class="text-accent">Soluciones</span>
    </a>

    <nav class="hidden md:flex gap-8 items-center">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-neutral-dark hover:text-primary font-medium transition-colors font-sans"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a 
        href="tel:+34600000000" 
        class="bg-primary-dark text-white px-5 py-2.5 rounded-lg font-bold font-display hover:bg-primary transition-colors flex items-center gap-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
        </svg>
        Llamar Ahora
      </a>
    </div>

    <button id="menu-toggle" class="md:hidden text-primary-dark focus:outline-none">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 absolute w-full shadow-lg">
    <div class="flex flex-col px-4 py-4 gap-4">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-neutral-dark font-medium py-2 hover:text-accent border-b border-gray-50 last:border-0"
        >
          {item.name}
        </a>
      ))}
      <a 
        href="tel:+34600000000" 
        class="bg-accent text-white text-center py-3 rounded-lg font-bold mt-2"
      >
        Llamar Ahora
      </a>
    </div>
  </div>
</header>

<script>
  // Script simple para abrir/cerrar el menú en móvil
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>