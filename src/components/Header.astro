---
const navItems = [
  { name: 'Servicios', href: '#servicios' },
  { name: 'Empresa', href: '/empresa' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Contacto', href: '#contacto' },
];
---

<header class="fixed top-0 w-full z-50 transition-all duration-300 bg-dark-bg/90 backdrop-blur-md border-b border-white/5">
  <div class="container mx-auto px-8 lg:px-20 h-24 flex justify-between items-center">
    
    <a href="/" class="text-2xl font-display font-bold tracking-tight text-white group">
      DIMIX <span class="text-accent group-hover:text-white transition-colors">SOLUCIONES</span>
      <span class="block text-[10px] font-sans font-normal text-gray-400 tracking-[0.2em] uppercase">Electricidad & Clima</span>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-gray-300 hover:text-accent transition-colors uppercase tracking-wide"
        >
          {item.name}
        </a>
      ))}
      
      <a 
        href="tel:+34600000000" 
        class="bg-accent hover:bg-accent-hover text-white px-6 py-3 rounded-full font-bold text-sm transition-all flex items-center gap-2 shadow-lg shadow-accent/20"
      >
        <i class="ti ti-phone"></i>
        600 000 000
      </a>
    </nav>

    <button class="md:hidden text-white p-2">
      <i class="ti ti-menu-2 text-3xl"></i>
    </button>

  </div>
</header>