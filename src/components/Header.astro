---
import { Icon } from 'astro-icon/components';

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Servicios', href: '/servicios' },
  { name: 'Empresa', href: '/empresa' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Contacto', href: '/contact' },
];
---

<header class="fixed top-0 w-full z-50 transition-all duration-300 bg-dark-bg/90 backdrop-blur-md border-b border-white/5">
  <div class="container mx-auto px-8 lg:px-20 h-24 flex justify-between items-center">
    
    <a href="/" class="text-2xl font-display font-bold tracking-tight text-white group" aria-label="Ir al inicio">
      DIMIX <span class="text-accent group-hover:text-white transition-colors">SOLUCIONES</span>
      <span class="block text-[10px] font-sans font-normal text-gray-400 tracking-[0.2em] uppercase">Electricidad & Clima</span>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-gray-300 hover:text-accent transition-colors uppercase tracking-wide"
        >
          {item.name}
        </a>
      ))}
      
      <a 
        href="tel:+34600000000" 
        class="bg-accent hover:bg-accent-hover text-primary px-6 py-3 rounded-full font-bold text-sm transition-all flex items-center gap-2 shadow-lg shadow-accent/20 hover:shadow-accent/40"
        aria-label="Llamar al 600 000 000"
      >
        <Icon name="tabler:phone" class="text-lg" />
        600 000 000
      </a>
    </nav>

    <button 
      id="menu-toggle" 
      class="md:hidden text-white p-2 focus:outline-none focus:ring-2 focus:ring-accent rounded-lg"
      aria-label="Abrir menú de navegación"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <Icon name="tabler:menu-2" id="icon-menu" class="text-3xl block transition-transform" />
      <Icon name="tabler:x" id="icon-close" class="text-3xl hidden transition-transform" />
    </button>

  </div>

  <div 
    id="mobile-menu" 
    class="md:hidden hidden flex-col bg-dark-bg border-t border-white/10 px-8 py-6 gap-6 absolute w-full left-0 shadow-2xl"
  >
    {navItems.map((item) => (
      <a 
        href={item.href} 
        class="text-base font-medium text-gray-300 hover:text-accent transition-colors uppercase tracking-wide border-b border-white/5 pb-2"
      >
        {item.name}
      </a>
    ))}

    <a 
      href="tel:+34600000000" 
      class="bg-accent text-primary px-6 py-3 rounded-full font-bold text-sm flex items-center gap-2 w-fit mt-2"
    >
      <Icon name="tabler:phone" class="text-lg" />
      600 000 000
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    
    // Toggle Menú
    if (isHidden) {
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      // Accesibilidad
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
      // Iconos
      iconMenu?.classList.add('hidden');
      iconMenu?.classList.remove('block');
      iconClose?.classList.remove('hidden');
      iconClose?.classList.add('block');
    } else {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      // Accesibilidad
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
      // Iconos
      iconMenu?.classList.remove('hidden');
      iconMenu?.classList.add('block');
      iconClose?.classList.add('hidden');
      iconClose?.classList.remove('block');
    }
  });

  // Cerrar menú al hacer clic en un enlace
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
        menu?.classList.add('hidden');
        menu?.classList.remove('flex');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        
        iconMenu?.classList.remove('hidden');
        iconMenu?.classList.add('block');
        iconClose?.classList.add('hidden');
        iconClose?.classList.remove('block');
    });
  });
</script>