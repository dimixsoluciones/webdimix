---
---

<section class="relative bg-primary-soft overflow-hidden">
  <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-primary-light/10 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-6 py-16 md:py-24 lg:py-32 flex flex-col-reverse md:flex-row items-center gap-12 relative z-10">
    
    <div class="w-full md:w-1/2 space-y-8 text-center md:text-left">
      
      <div class="space-y-4">
        <span class="inline-block py-1 px-4 rounded-full bg-white text-primary-dark font-bold text-xs uppercase tracking-widest border border-primary/10 shadow-sm">
          <i class="ti ti-map-pin-filled text-accent"></i> Servicio en Madrid y alrededores
        </span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-primary-dark leading-[1.1]">
          Instalaciones Eléctricas y Climatización con <span class="text-accent">Garantía Profesional</span>
        </h1>

        <p class="text-lg text-neutral-dark font-sans max-w-xl mx-auto md:mx-0 leading-relaxed">
          Soluciones completas para tu hogar o proyecto de construcción. 
          <span class="block mt-2 font-semibold text-primary-dark text-xl underline decoration-accent/30">Presupuesto sin compromiso en 24h.</span>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 pt-4 justify-center md:justify-start">
        <a 
          href="#contacto" 
          class="bg-accent hover:bg-accent-light text-white text-center px-10 py-5 rounded-xl font-bold text-lg shadow-xl shadow-accent/20 transition-all transform hover:-translate-y-1 flex items-center justify-center gap-2"
        >
          Solicitar Presupuesto Gratis
          <i class="ti ti-arrow-right"></i>
        </a>
      </div>
      
      <div class="flex flex-wrap items-center gap-6 justify-center md:justify-start text-sm text-neutral-dark/80 font-medium">
        <span class="flex items-center gap-2"><i class="ti ti-circle-check text-green-500 text-xl"></i> Instalador Autorizado</span>
        <span class="flex items-center gap-2"><i class="ti ti-clock-check text-primary text-xl"></i> Respuesta en 24h</span>
      </div>
    </div>

    <div class="w-full md:w-1/2 relative">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl border-[12px] border-white group">
        <img 
          src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?q=80&w=2069&auto=format&fit=crop" 
          alt="Técnico profesional trabajando en cuadro eléctrico moderno" 
          class="w-full h-full object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700"
        />
        
        <div class="absolute top-6 right-6 bg-white/95 backdrop-blur-sm px-4 py-3 rounded-2xl shadow-lg border border-primary/5 flex items-center gap-3">
          <div class="bg-primary-soft p-2 rounded-full">
            <i class="ti ti-shield-check text-primary text-2xl"></i>
          </div>
          <div>
            <p class="text-xs text-neutral-dark font-bold">100% Seguro</p>
            <p class="text-[10px] text-gray-400 uppercase tracking-tighter">Cumplimiento REBT</p>
          </div>
        </div>
      </div>

      <div class="absolute -bottom-6 -left-6 bg-accent p-4 rounded-2xl shadow-lg hidden lg:block animate-bounce-slow">
         <i class="ti ti-bolt text-white text-3xl"></i>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .animate-bounce-slow {
    animation: bounce-slow 4s ease-in-out infinite;
  }
</style>