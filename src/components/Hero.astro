---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components'; // Componente optimizado para iconos
import hero from '../../public/img/hero.webp';

const bgDots = Array(16).fill(0);
const bgDotsRight = Array(24).fill(0);
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-dark-bg">
  
  <div class="absolute left-0 top-1/3 hidden lg:grid grid-cols-2 gap-2 opacity-10 pointer-events-none" aria-hidden="true">
    {bgDots.map(() => <div class="w-1.5 h-1.5 bg-white rounded-full"></div>)}
  </div>

  <div class="container mx-auto max-w-7xl px-8 lg:px-20 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      
      <div class="w-full lg:w-1/2 space-y-8">
        
        <div class="flex items-center gap-4">
          <span class="w-12 h-0.5 bg-accent"></span>
          <span class="text-accent font-bold tracking-[0.2em] uppercase text-sm">Electricistas en Madrid</span>
        </div>

        <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold text-white leading-[1.1] uppercase">
          Soluciones <br />
          Eléctricas <br />
          <span class="text-accent">Confiables</span>
        </h1>

        <p class="text-gray-400 text-lg max-w-lg font-sans leading-relaxed border-l-2 border-gray-700 pl-6">
          Expertos en instalaciones y reparaciones urgentes. 
          Resultados rápidos, seguros y eficientes para tu hogar o negocio.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a 
            href="tel:+34624731030" 
            class="bg-accent hover:bg-accent-hover text-primary px-8 py-4 rounded-full font-bold transition-all flex items-center gap-3 shadow-[0_0_20px_rgba(229,114,0,0.3)] hover:shadow-[0_0_30px_rgba(229,114,0,0.5)]"
            aria-label="Llamar ahora al 624 731 030"
          >
            <Icon name="tabler:phone-calling" class="text-xl" />
            624 731 030
          </a>
          
          <a 
            href="#servicios" 
            class="group px-8 py-4 rounded-full font-bold text-white border border-gray-600 hover:border-white transition-all flex items-center gap-2"
          >
            Ver Servicios
            <Icon name="tabler:arrow-right" class="text-xl group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>

      <div class="w-full lg:w-1/2 relative">
        <div class="absolute -right-4 top-10 hidden lg:grid grid-cols-2 gap-2 opacity-20 z-0 pointer-events-none" aria-hidden="true">
          {bgDotsRight.map(() => <div class="w-1.5 h-1.5 bg-gray-500 rounded-full"></div>)}
        </div>

        <div class="relative z-10 rounded-[2.5rem] overflow-hidden border-4 border-gray-800 shadow-2xl group h-[500px] lg:h-[600px]">
          <Image 
            src={hero} 
            alt="Técnico electricista Dimix realizando reparación"
            width={800}
            height={600}
            loading="eager"
            fetchpriority="high"
            widths={[400, 600, 800, 1200]}
            sizes="(max-width: 768px) 100vw, 50vw"
            class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105 filter brightness-90 group-hover:brightness-100"
          />
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>

          <div class="absolute bottom-8 left-8 bg-accent p-6 rounded-2xl shadow-xl flex flex-col gap-1 items-start max-w-[180px]">
             <Icon name="tabler:certificate" class="text-4xl text-primary mb-2" />
             <span class="text-3xl font-display font-bold text-primary leading-none">100%</span>
             <span class="text-primary/90 text-xs uppercase font-bold tracking-wider leading-tight">Garantía Profesional</span>
          </div>

          <div class="absolute bottom-8 right-8 bg-dark-card/90 backdrop-blur-sm p-3 rounded-full lg:rounded-xl border border-gray-700 flex items-center gap-3 pr-5">
            <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse ml-1"></div>
            <span class="text-xs font-bold text-white uppercase tracking-wider hidden lg:block">Disponible 24h</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>