---
import { Icon } from 'astro-icon/components';
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark-card text-white border-t border-gray-800 pt-16 pb-8 mt-auto">
  <div class="container mx-auto px-8 lg:px-20">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <div class="space-y-6">
        <a href="/" class="text-2xl font-display font-bold tracking-tight text-white block">
          DIMIX <span class="text-accent">SOLUCIONES</span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Expertos en instalaciones eléctricas y climatización en la Comunidad de Madrid. 
          Comprometidos con la seguridad, la eficiencia y el cumplimiento normativo.
        </p>
        
        
      </div>

      <div>
        <h4 class="text-lg font-bold font-display uppercase tracking-wider mb-6 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          Navegación
        </h4>
        <!-- CAMBIO: Eliminado enlace a /proyectos -->
        <ul class="space-y-4">
          <li><a href="/" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:chevron-right" class="text-xs" /> Inicio</a></li>
          <li><a href="/empresa" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:chevron-right" class="text-xs" /> Empresa</a></li>
          <li><a href="#contacto" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:chevron-right" class="text-xs" /> Contacto</a></li>
          <li><a href="#faq" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:chevron-right" class="text-xs" /> FAQ</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-bold font-display uppercase tracking-wider mb-6 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          Servicios
        </h4>
        <ul class="space-y-4">
          <li><a href="/servicios/mantenimiento/urgencias-24h" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:bolt" class="text-accent text-lg" /> Urgencias 24h</a></li>
          <li><a href="/servicios/mantenimiento/cuadros-electricos" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:box" class="text-lg" /> Cuadros Eléctricos</a></li>
          <li><a href="/servicios/instalaciones/viviendas" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:home" class="text-lg" /> Instalaciones</a></li>
          <li><a href="/servicios/renovables/placas-solares" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:sun" class="text-lg" /> Placas Solares</a></li>
          <li><a href="/servicios/renovables/cargadores-ve" class="text-gray-400 hover:text-accent transition-colors flex items-center gap-2"><Icon name="tabler:car" class="text-lg" /> Cargadores VE</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-bold font-display uppercase tracking-wider mb-6 flex items-center gap-2">
          <span class="w-2 h-2 bg-accent rounded-full"></span>
          Contacto
        </h4>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <div class="mt-1 bg-dark-bg p-2 rounded text-accent border border-gray-700">
              <Icon name="tabler:map-pin" class="text-xl" />
            </div>
            <div>
              <span class="block text-xs text-gray-500 uppercase font-bold">Ubicación</span>
              <span class="text-gray-300">Comunidad de Madrid,<br/>España</span>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="mt-1 bg-dark-bg p-2 rounded text-accent border border-gray-700">
              <Icon name="tabler:phone" class="text-xl" />
            </div>
            <div>
              <span class="block text-xs text-gray-500 uppercase font-bold">Urgencias</span>
              <a href="tel:+34624 731 030" class="text-white font-bold hover:text-accent transition-colors">624 731 030</a>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="mt-1 bg-dark-bg p-2 rounded text-accent border border-gray-700">
               <Icon name="tabler:mail" class="text-xl" />
            </div>
            <div>
              <span class="block text-xs text-gray-500 uppercase font-bold">Email</span>
              <a href="mailto:dimixsoluciones@gmail.com" class="text-gray-300 hover:text-accent transition-colors">dimixsoluciones@gmail.com</a>
            </div>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
      <p>&copy; {currentYear} Dimix Soluciones. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="/legal/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/legal/cookies" class="hover:text-white transition-colors">Cookies</a>
        <a href="/legal/aviso-legal" class="hover:text-white transition-colors">Aviso Legal</a>
      </div>
    </div>

  </div>
</footer>