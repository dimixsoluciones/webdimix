---
import { Icon } from 'astro-icon/components'; // <--- IMPORTANTE
---

<section id="contacto" class="py-24 bg-dark-bg text-white relative overflow-hidden">
  
  <div class="absolute left-0 bottom-0 grid grid-cols-2 gap-2 opacity-5 pointer-events-none" aria-hidden="true">
    {Array(20).fill(0).map(() => <div class="w-2 h-2 bg-white rounded-full"></div>)}
  </div>

  <div class="container mx-auto max-w-7xl px-8 lg:px-20 relative z-10">
    <div class="flex flex-col lg:flex-row gap-16 lg:gap-24">
      
      <div class="w-full lg:w-1/2 space-y-8">
        
        <div class="flex items-center gap-4">
          <span class="w-8 h-0.5 bg-accent"></span>
          <span class="text-accent font-bold tracking-[0.2em] uppercase text-sm">Hablemos</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-display font-bold leading-tight uppercase">
          ¿NECESITAS UN <br />
          <span class="text-accent">PRESUPUESTO?</span>
        </h2>

        <p class="text-gray-400 text-lg leading-relaxed font-sans border-l-2 border-gray-700 pl-6">
          Rellena el formulario para obtener una valoración precisa. 
          Te responderemos en menos de 24 horas con una solución a medida.
        </p>

        <div class="space-y-6 pt-6">
          
          <a href="tel:+34600000000" class="flex items-center gap-6 group">
            <div class="w-14 h-14 bg-dark-card border border-gray-700 rounded-2xl flex items-center justify-center text-accent text-2xl group-hover:bg-accent group-hover:text-white transition-all duration-300">
              <Icon name="tabler:phone" class="text-3xl" />
            </div>
            <div>
              <span class="block text-xs text-gray-500 uppercase tracking-wider font-bold">Llámanos 24h</span>
              <span class="text-2xl font-display font-bold text-white group-hover:text-accent transition-colors">600 000 000</span>
            </div>
          </a>

          <a href="mailto:info@dimixsoluciones.com" class="flex items-center gap-6 group">
            <div class="w-14 h-14 bg-dark-card border border-gray-700 rounded-2xl flex items-center justify-center text-accent text-2xl group-hover:bg-accent group-hover:text-white transition-all duration-300">
              <Icon name="tabler:mail" class="text-3xl" />
            </div>
            <div>
              <span class="block text-xs text-gray-500 uppercase tracking-wider font-bold">Escríbenos</span>
              <span class="text-xl font-display font-bold text-white group-hover:text-accent transition-colors">info@dimixsoluciones.com</span>
            </div>
          </a>

          <div class="flex items-center gap-6 group">
            <div class="w-14 h-14 bg-dark-card border border-gray-700 rounded-2xl flex items-center justify-center text-accent text-2xl">
              <Icon name="tabler:map-pin" class="text-3xl" />
            </div>
            <div>
              <span class="block text-xs text-gray-500 uppercase tracking-wider font-bold">Oficina Central</span>
              <span class="text-xl font-display font-bold text-white">Comunidad de Madrid</span>
            </div>
          </div>

        </div>
      </div>

      <div class="w-full lg:w-1/2">
        <div class="bg-dark-card p-8 md:p-10 rounded-[2rem] border border-gray-700 shadow-2xl relative">
          
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-accent to-transparent opacity-50"></div>

          <form id="contact-form" class="space-y-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="text-sm font-bold text-gray-400 uppercase tracking-wider">Nombre</label>
                <input required type="text" name="name" id="name" placeholder="Tu nombre" class="w-full bg-dark-bg border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors placeholder-gray-600" />
              </div>
              <div class="space-y-2">
                <label for="phone" class="text-sm font-bold text-gray-400 uppercase tracking-wider">Teléfono</label>
                <input required type="tel" name="phone" id="phone" placeholder="600 000 000" class="w-full bg-dark-bg border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors placeholder-gray-600" />
              </div>
            </div>

            <div class="space-y-2">
              <label for="email" class="text-sm font-bold text-gray-400 uppercase tracking-wider">Email</label>
              <input required type="email" name="email" id="email" placeholder="tu@email.com" class="w-full bg-dark-bg border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors placeholder-gray-600" />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              <div class="space-y-2 relative">
                <label for="service" class="text-sm font-bold text-gray-400 uppercase tracking-wider">Servicio Deseado</label>
                <div class="relative">
                  <select name="service" id="service" class="w-full bg-dark-bg border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors appearance-none cursor-pointer">
                    <option value="" disabled selected>Selecciona una opción</option>
                    <option value="Urgencia 24h" class="bg-dark-bg">⚡ Urgencia 24h</option>
                    <option value="Reparacion" class="bg-dark-bg">Reparación / Avería</option>
                    <option value="Instalacion Nueva" class="bg-dark-bg">Instalación Nueva</option>
                    <option value="Cuadro Electrico" class="bg-dark-bg">Cuadro Eléctrico</option>
                    <option value="Iluminacion LED" class="bg-dark-bg">Iluminación LED</option>
                    <option value="Placas Solares" class="bg-dark-bg">Placas Solares</option>
                    <option value="Cargador VE" class="bg-dark-bg">Cargador Coche Eléctrico</option>
                    <option value="Otro" class="bg-dark-bg">Otro / Consulta</option>
                  </select>
                  <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                    <Icon name="tabler:chevron-down" class="text-xl" />
                  </div>
                </div>
              </div>

              <div class="space-y-2 relative">
                <label for="budget" class="text-sm font-bold text-gray-400 uppercase tracking-wider">Presupuesto Aprox.</label>
                <div class="relative">
                  <select name="budget" id="budget" class="w-full bg-dark-bg border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors appearance-none cursor-pointer">
                    <option value="" disabled selected>Rango estimado</option>
                    <option value="-500" class="bg-dark-bg">Menos de 500€ (Pequeño)</option>
                    <option value="500-2000" class="bg-dark-bg">500€ - 2.000€ (Medio)</option>
                    <option value="2000-5000" class="bg-dark-bg">2.000€ - 5.000€ (Grande)</option>
                    <option value="+5000" class="bg-dark-bg">+5.000€ (Proyecto/Reforma)</option>
                    <option value="Desconocido" class="bg-dark-bg">No lo sé / A valorar</option>
                  </select>
                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-gray-400">
                     <Icon name="tabler:chevron-down" class="text-xl" />
                  </div>
                </div>
              </div>

            </div>

            <div class="space-y-2">
              <label for="message" class="text-sm font-bold text-gray-400 uppercase tracking-wider">Mensaje</label>
              <textarea required name="message" id="message" rows="3" placeholder="Cuéntanos más detalles sobre lo que necesitas..." class="w-full bg-dark-bg border border-gray-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors resize-none placeholder-gray-600"></textarea>
            </div>

            <button id="submit-btn" type="submit" class="w-full bg-accent hover:bg-accent-hover text-white font-bold py-4 rounded-xl shadow-lg shadow-accent/20 transition-all transform hover:-translate-y-1 flex justify-center items-center gap-2">
              <span id="btn-text">ENVIAR SOLICITUD</span>
            </button>
            
            <p id="form-status" class="text-xs text-gray-500 text-center mt-4">
              Al enviar aceptas nuestra <a href="/legal/privacidad" class="underline hover:text-white">Política de Privacidad</a>.
            </p>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Script para manejar el envío sin redirección
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const button = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  
  // ¡PON TU ID DE FORMSPREE AQUÍ! 👇
  const FORMSPREE_ID = "TU_ID_DE_FORMSPREE"; 

  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault(); // Evita que la página se recargue o redirija

      const formData = new FormData(form);
      
      // Estado: Enviando...
      if(button && btnText) {
          button.disabled = true;
          btnText.innerText = "Enviando...";
          button.classList.add('opacity-75', 'cursor-not-allowed');
      }

      try {
        const response = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // ÉXITO: Cambiar botón a verde y mensaje
          if(button && btnText) {
            form.reset(); // Limpiar campos
            btnText.innerText = "¡Mensaje Enviado!";
            button.classList.remove('bg-accent', 'hover:bg-accent-hover');
            button.classList.add('bg-green-600', 'hover:bg-green-700'); // Color verde éxito

            // Esperar 2 segundos y volver a la normalidad
            setTimeout(() => {
                btnText.innerText = "ENVIAR SOLICITUD";
                button.disabled = false;
                button.classList.remove('opacity-75', 'cursor-not-allowed', 'bg-green-600', 'hover:bg-green-700');
                button.classList.add('bg-accent', 'hover:bg-accent-hover');
            }, 2000);
          }
        } else {
          // Error en Formspree
          if(btnText) btnText.innerText = "Error. Inténtalo de nuevo.";
          setTimeout(() => {
             if(button && btnText) {
                 button.disabled = false;
                 btnText.innerText = "ENVIAR SOLICITUD";
                 button.classList.remove('opacity-75', 'cursor-not-allowed');
             }
          }, 3000);
        }
      } catch (error) {
        // Error de red
        if(btnText) btnText.innerText = "Error de conexión";
        if(button) button.disabled = false;
      }
    });
  }
</script>